// ============================================================
// SIM-KIPAN v2 — Sistem Informasi Keanggotaan KIPAN Indonesia
// Prisma Schema
// Database: MySQL (kipan_db)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN | ADMIN_NASIONAL | ADMIN_PROVINSI | ADMIN_KABUPATEN
  status       String   @default("Aktif") // Aktif | Nonaktif
  avatar       String?  @db.LongText

  provinsiId   Int?
  kabupatenId  Int?

  anggota      Anggota?
  provinsi     Provinsi? @relation(fields: [provinsiId], references: [id])
  kabupaten    Kabupaten? @relation(fields: [kabupatenId], references: [id])
  notifications Notification[]

  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ============================================================
// WILAYAH (PROVINSI & KABUPATEN)
// ============================================================

model Provinsi {
  id           Int      @id @default(autoincrement())
  kode         String   @unique
  nama         String
  status       String   @default("Aktif") // Aktif | Pembentukan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kabupaten       Kabupaten[]
  anggota         Anggota[]
  pengurus        Pengurus[]
  pendaftaran     Pendaftaran[]
  users           User[]
  suratKeputusan  SuratKeputusan[]

  @@map("provinsi")
}

model Kabupaten {
  id           Int      @id @default(autoincrement())
  kode         String   @unique
  nama         String
  provinsiId   Int
  status       String   @default("Aktif")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provinsi        Provinsi @relation(fields: [provinsiId], references: [id])
  anggota         Anggota[]
  pengurus        Pengurus[]
  pendaftaran     Pendaftaran[]
  users           User[]
  suratKeputusan  SuratKeputusan[]

  @@map("kabupaten")
}

// ============================================================
// PENDAFTARAN ANGGOTA (Calon Anggota)
// ============================================================

model Pendaftaran {
  id            Int      @id @default(autoincrement())
  nomorPendaftaran String @unique // Format: REG-YYYYMM-XXXX (untuk tracking oleh pendaftar)
  namaLengkap   String
  nik           String
  tempatLahir   String
  tanggalLahir  DateTime
  jenisKelamin  String   // L | P
  agama         String?
  pendidikan    String?
  pekerjaan     String?
  statusPribadi String?

  alamat        String
  provinsiId    Int
  kabupatenId   Int
  kecamatan     String?
  desa          String?
  kodePos       String?

  email         String
  whatsapp      String?
  motivasi      String?

  foto          String?  @db.LongText
  ktp           String?  @db.LongText
  cv            String?  @db.LongText
  sk            String?  @db.LongText
  suratPernyataan String?  @db.LongText
  suratSehat    String?  @db.LongText

  // Checklist persyaratan (JSON string)
  persyaratan   String   @default("[]")

  // DRAFT | DIAJUKAN | DIVERIFIKASI | DISETUJUI | DITOLAK | PERBAIKAN
  status        String   @default("DRAFT")
  catatan       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provinsi      Provinsi  @relation(fields: [provinsiId], references: [id])
  kabupaten     Kabupaten @relation(fields: [kabupatenId], references: [id])
  riwayat       PendaftaranRiwayat[]

  @@map("pendaftaran")
}

model PendaftaranRiwayat {
  id            Int      @id @default(autoincrement())
  pendaftaranId Int
  aksi          String
  oleh          String
  catatan       String?
  createdAt     DateTime @default(now())

  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@map("pendaftaran_riwayat")
}

// ============================================================
// ANGGOTA (Setelah disetujui)
// ============================================================

model Anggota {
  id            Int      @id @default(autoincrement())
  nia           String   @unique // Nomor Induk Anggota, format: KIPAN-JBR-3204-2026-00012
  namaLengkap   String
  nik           String
  tempatLahir   String
  tanggalLahir  DateTime
  jenisKelamin  String
  agama         String?
  pendidikan    String?
  pekerjaan     String?

  alamat        String
  provinsiId    Int
  kabupatenId   Int
  kecamatan     String?
  desa          String?
  kodePos       String?

  email         String
  whatsapp      String?
  foto          String?  @db.LongText

  // Dokumen pendukung (base64 data URL atau URL file)
  ktp           String?  @db.LongText
  cv            String?  @db.LongText
  sk            String?  @db.LongText
  suratPernyataan String?  @db.LongText
  suratSehat    String?  @db.LongText

  // AKTIF | NONAKTIF | MENGUNDURKAN_DIRI | DIBERHENTIKAN | MENINGGAL
  status        String   @default("AKTIF")
  angkatan      String?
  tanggalDaftar DateTime @default(now())
  tanggalAngkat DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])

  provinsi      Provinsi  @relation(fields: [provinsiId], references: [id])
  kabupaten     Kabupaten @relation(fields: [kabupatenId], references: [id])
  pengurus      Pengurus[]

  @@map("anggota")
}

// ============================================================
// SURAT KEPUTUSAN (SK) — Entitas utama kepengurusan
// SK memuat daftar pengurus yang diangkat
// ============================================================

model SuratKeputusan {
  id              Int       @id @default(autoincrement())
  nomorSK         String    @unique
  judul           String
  level           String    // NASIONAL | PROVINSI | KABUPATEN
  provinsiId      Int?
  kabupatenId     Int?
  tanggalTerbit   DateTime
  tanggalBerakhir DateTime?
  fileSK          String?   @db.LongText
  status          String    @default("Aktif") // Aktif | TidakAktif
  approvalStatus  String    @default("DRAFT") // DRAFT | MENUNGGU_PROVINSI | MENUNGGU_NASIONAL | DISETUJUI | DITOLAK
  catatanPenolakan String?  @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provinsi        Provinsi?  @relation(fields: [provinsiId], references: [id])
  kabupaten       Kabupaten? @relation(fields: [kabupatenId], references: [id])
  pengurus        Pengurus[]

  @@map("surat_keputusan")
}

// ============================================================
// PENGURUS (Anggota + SK + Wilayah)
// Pengurus = Anggota yang tercantum dalam Surat Keputusan
// Memiliki jabatan yang dipilih dari referensi Jabatan
// ============================================================

model Pengurus {
  id               Int      @id @default(autoincrement())
  anggotaId        Int
  suratKeputusanId Int
  level            String   // NASIONAL | PROVINSI | KABUPATEN
  provinsiId       Int?
  kabupatenId      Int?
  jabatanId        Int?
  status           String   @default("Aktif") // Aktif | Demisioner | Diberhentikan | Mengundurkan Diri | Meninggal
  keteranganStatus String?  @db.Text
  tanggalMulai     DateTime @default(now())
  tanggalSelesai   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  anggota          Anggota        @relation(fields: [anggotaId], references: [id])
  suratKeputusan   SuratKeputusan @relation(fields: [suratKeputusanId], references: [id])
  provinsi         Provinsi?      @relation(fields: [provinsiId], references: [id])
  kabupaten        Kabupaten?     @relation(fields: [kabupatenId], references: [id])
  jabatan          Jabatan?       @relation(fields: [jabatanId], references: [id])

  @@map("pengurus")
}

// ============================================================
// JABATAN (Referensi Jabatan Pengurus)
// ============================================================

model Jabatan {
  id        Int      @id @default(autoincrement())
  nama      String
  level     String   // NASIONAL | PROVINSI | KABUPATEN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  pengurus  Pengurus[]

  @@map("jabatan")
}

// ============================================================
// CMS - BERITA
// ============================================================

model Berita {
  id            Int      @id @default(autoincrement())
  judul         String
  slug          String   @unique
  kategori      String   // Nasional | Provinsi | Kabupaten
  excerpt       String   @db.Text
  konten        String   @db.LongText
  thumbnail     String?  @db.LongText
  penulis       String
  status        String   @default("Draft") // Draft | Published
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("berita")
}

// ============================================================
// CMS - GALERI
// ============================================================

model Galeri {
  id            Int      @id @default(autoincrement())
  judul         String
  album         String?
  foto          String   @db.LongText
  lokasi        String?
  kategori      String   @default("Kegiatan") // Kegiatan | Pelatihan | Sosialisasi | Rapat | Kampanye
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("galeri")
}

// ============================================================
// CMS - PROGRAM KERJA
// ============================================================

model ProgramKerja {
  id            Int      @id @default(autoincrement())
  nama          String
  deskripsi     String?
  // Nasional | Provinsi | Kabupaten
  tingkat       String
  pic           String?
  tanggalMulai  DateTime
  tanggalSelesai DateTime?
  // Direncanakan | Berjalan | Selesai
  status        String   @default("Direncanakan")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("program_kerja")
}

// ============================================================
// PROFIL ORGANISASI (Settings)
// ============================================================

model ProfilOrganisasi {
  id            Int      @id @default(1)
  nama          String
  namaLengkap   String
  tagline       String?
  logo          String?  @db.LongText
  email         String?
  telepon       String?
  alamat        String?
  instagram     String?
  website       String?
  deskripsi     String?
  updatedAt     DateTime @updatedAt

  @@map("profil_organisasi")
}

// ============================================================
// ACTIVITY LOG — Audit trail untuk semua mutasi data
// ============================================================

model ActivityLog {
  id        Int      @id @default(autoincrement())
  table     String   // "pengurus" | "wilayah" | "surat_keputusan" | "anggota" | "pendaftaran"
  recordId  Int
  aksi      String   // "create" | "update" | "delete" | "approve" | "reject" | "nonaktifkan_sk"
  oleh      String   @default("Admin") // "Admin" | "Sistem"
  detail    String?  // JSON string dengan perubahan
  createdAt DateTime @default(now())

  @@map("activity_log")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String
  type      String   // PENDAFTARAN | SK | VERIFIKASI | SISTEM
  link      String?  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
